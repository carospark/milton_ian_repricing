# Licensed inputs must never be committed. Only code, small derived summaries and figures go in git.
# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.DS_Store

# Raw / licensed data of any kind (Artemis caches, WRDS/TRACE exports, N-PORT, market snapshots)
data/raw/
data/cache/
*.parquet
*.sqlite
*.db
*.feather
*.pkl
*.h5
*.zip

# Derived outputs: ignored by default, explicitly whitelisted summaries below
data/derived/*
!data/derived/.gitkeep
# --- whitelist (small derived summary tables, safe to commit) ---
!data/derived/coverage_summary_milton.csv
!data/derived/coverage_summary_ian.csv
!data/derived/milton_contracts.csv
!data/derived/hurricane_coverage_comparison.csv
!data/derived/comparison_contracts.csv
!data/derived/public_study_coverage.csv
!data/derived/public_timing_summary.csv
!data/derived/public_wsp_inventory.csv
!data/derived/public_focus_review_summary.csv
!data/derived/public_repricing_summary.csv
!data/derived/public_nhc_intensity.csv
!data/derived/public_loss_audit_summary.csv
!data/derived/public_beryl_scope_summary.csv

# Local study plan (retain on disk, exclude from future commits).
docs/[Hh]urricane_[Rr]epricing_[Ss]tudy_[Pp]lan.pdf

# Machine-local history and older detailed reports are not publication artifacts.
docs/.Rhistory
docs/Hurricane_Coverage_Comparison.html

# Notebook outputs
notebooks/*.html
